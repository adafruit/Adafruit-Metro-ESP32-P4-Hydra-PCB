<text x="7.62" y="254" size="1.778" layer="98" font="vector">C6 ESP-AT / SDIO</text>
<text x="86.36" y="169.164" size="0.889" layer="97" font="vector">ESP-AT SDIO; GPIO8 pulled high.</text>
<text x="86.36" y="167.386" size="0.889" layer="97" font="vector">C6_EN GPIO54; wake GPIO6.</text>
<text x="86.36" y="165.608" size="0.889" layer="97" font="vector">P4 holds BOOT9 low for flashing.</text>
<text x="86.36" y="163.83" size="0.889" layer="97" font="vector">Private UART; Metro TX/RX unchanged.</text>
<wire x1="289.56" y1="38.1" x2="337.82" y2="38.1" width="0.1524" layer="98" style="shortdash"/>
